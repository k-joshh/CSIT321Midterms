@page "/high-low"
@rendermode InteractiveServer
@using Midterms.Models
@inject Midterms.Services.UserStateService UserState

<div class="max-w-xl mx-auto">
    <div class="text-center mb-6">
        <h1 class="text-3xl font-black text-[#E4A700] tracking-wide drop-shadow">HIGH / LOW</h1>
        <p class="text-amber-200/70 text-sm font-medium">Guess if the next card will be Higher or Lower. Ace is High.</p>
    </div>

    @if (UserState.CurrentUser == null)
    {
        <div class="bg-[#7B1414]/40 border border-[#A46928] p-6 rounded-2xl text-center shadow-lg">
            <p class="text-[#E4A700] font-medium">Please enter a username on the <a href="/" class="underline text-white font-bold">Home Page</a> before playing.</p>
        </div>
    }
    else
    {
        <div class="bg-[#7B1414]/30 border-4 border-[#A46928] rounded-3xl p-8 shadow-2xl relative">
            
            <div class="flex justify-center items-center space-x-8 mb-8">
                <div class="text-center">
                    <span class="text-xs text-[#E4A700] font-bold block mb-2 uppercase tracking-wider">Current Card</span>
                    @if (currentCard != null)
                    {
                        <div class="w-24 h-36 bg-[#FFFFFF] border-2 border-[#A46928] rounded-xl p-3 flex flex-col justify-between shadow-2xl @currentCard.TextColor">
                            <span class="text-lg font-bold">@currentCard.DisplayRank</span>
                            <span class="text-4xl self-center">@currentCard.SuitSymbol</span>
                            <span class="text-lg font-bold self-end">@currentCard.DisplayRank</span>
                        </div>
                    }
                </div>

                <div class="text-2xl font-black text-[#E4A700]/70">VS</div>

                <div class="text-center">
                    <span class="text-xs text-[#E4A700] font-bold block mb-2 uppercase tracking-wider">Next Card</span>
                    @if (nextCard != null)
                    {
                        <div class="w-24 h-36 bg-[#FFFFFF] border-2 border-[#A46928] rounded-xl p-3 flex flex-col justify-between shadow-2xl @nextCard.TextColor">
                            <span class="text-lg font-bold">@nextCard.DisplayRank</span>
                            <span class="text-4xl self-center">@nextCard.SuitSymbol</span>
                            <span class="text-lg font-bold self-end">@nextCard.DisplayRank</span>
                        </div>
                    }
                    else
                    {
                        <div class="w-24 h-36 bg-[#072475] border-2 border-dashed border-[#E4A700] rounded-xl flex items-center justify-center text-[#E4A700] font-black text-3xl shadow-inner">
                            ?
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(feedbackMessage))
            {
                <div class="text-center py-2.5 px-4 mb-6 rounded-lg bg-[#000000]/80 border border-[#A46928]">
                    <span class="font-bold text-[#E4A700]">@feedbackMessage</span>
                </div>
            }

            <div class="space-y-4">
                <div class="flex items-center justify-between bg-[#000000]/70 p-3 rounded-xl border border-[#A46928]">
                    <label class="text-sm font-semibold text-slate-200">Bet Amount:</label>
                    <input type="number" min="10" step="10" @bind="betAmount" disabled="@isGuessing" class="bg-[#000000] border border-[#A46928] rounded px-3 py-1 w-28 text-right font-black text-[#E4A700] focus:outline-none focus:border-[#E4A700]" />
                </div>

                @if (!isGuessing)
                {
                    <button @onclick="StartRound" class="w-full bg-[#E4A700] hover:bg-[#A46928] text-[#000000] font-black py-3 rounded-xl shadow-lg transition">
                        Place Bet & Play
                    </button>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-4">
                        <button @onclick="() => MakeGuess(true)" class="bg-[#13563B] hover:bg-[#13563B]/80 text-white font-extrabold py-3 rounded-xl border border-[#E4A700] shadow-lg transition">
                            ▲ HIGHER
                        </button>
                        <button @onclick="() => MakeGuess(false)" class="bg-[#C70000] hover:bg-[#C70000]/80 text-white font-extrabold py-3 rounded-xl border border-[#7B1414] shadow-lg transition">
                            ▼ LOWER
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private Deck deck = new();
    private Card? currentCard;
    private Card? nextCard;
    private decimal betAmount = 50;
    private bool isGuessing = false;
    private string feedbackMessage = "";

    protected override void OnInitialized()
    {
        deck.Reset();
        currentCard = deck.Draw();
    }

    private async Task StartRound()
    {
        if (UserState.CurrentUser!.Balance < betAmount)
        {
            feedbackMessage = "Not enough balance to place this bet.";
            return;
        }

        await UserState.UpdateBalanceAsync(-betAmount);
        nextCard = null;
        feedbackMessage = "Will the next card be higher or lower?";
        isGuessing = true;
    }

    private async Task MakeGuess(bool guessHigher)
    {
        nextCard = deck.Draw();
        isGuessing = false;

        int currentRank = (int)currentCard!.Rank;
        int nextRank = (int)nextCard.Rank;

        if (nextRank == currentRank)
        {
            feedbackMessage = "Push! Ranks are equal. Bet returned.";
            await UserState.UpdateBalanceAsync(betAmount);
        }
        else if ((guessHigher && nextRank > currentRank) || (!guessHigher && nextRank < currentRank))
        {
            feedbackMessage = $"Correct! You won 🪙 {betAmount * 2}!";
            await UserState.UpdateBalanceAsync(betAmount * 2);
        }
        else
        {
            feedbackMessage = "Incorrect guess! House wins.";
        }

        currentCard = nextCard;
    }
}