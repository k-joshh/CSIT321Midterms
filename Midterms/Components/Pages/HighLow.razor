@page "/high-low"
@rendermode InteractiveServer
@using Midterms.Models
@inject Midterms.Services.UserStateService UserState

<div class="max-w-xl mx-auto">
    <div class="text-center mb-6">
        <h1 class="text-3xl font-black text-amber-400">HIGH / LOW</h1>
        <p class="text-slate-400 text-sm">Guess if the next card will be Higher or Lower. Ace is High.</p>
    </div>

    @if (UserState.CurrentUser == null)
    {
        <div class="bg-amber-950/40 border border-amber-800 p-6 rounded-xl text-center">
            <p class="text-amber-300">Please enter a username on the <a href="/" class="underline font-bold">Home Page</a> before playing.</p>
        </div>
    }
    else
    {
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-xl">
            <!-- Cards Display -->
            <div class="flex justify-center items-center space-x-6 mb-8">
                <!-- Current Card -->
                <div class="text-center">
                    <span class="text-xs text-slate-400 block mb-2">Current Card</span>
                    @if (currentCard != null)
                    {
                        <div class="w-24 h-36 bg-white border border-slate-300 rounded-xl p-3 flex flex-col justify-between shadow-lg @currentCard.TextColor">
                            <span class="text-lg font-bold">@currentCard.DisplayRank</span>
                            <span class="text-4xl self-center">@currentCard.SuitSymbol</span>
                            <span class="text-lg font-bold self-end">@currentCard.DisplayRank</span>
                        </div>
                    }
                </div>

                <div class="text-2xl font-bold text-slate-600">VS</div>

                <!-- Next Card -->
                <div class="text-center">
                    <span class="text-xs text-slate-400 block mb-2">Next Card</span>
                    @if (nextCard != null)
                    {
                        <div class="w-24 h-36 bg-white border border-slate-300 rounded-xl p-3 flex flex-col justify-between shadow-lg @nextCard.TextColor">
                            <span class="text-lg font-bold">@nextCard.DisplayRank</span>
                            <span class="text-4xl self-center">@nextCard.SuitSymbol</span>
                            <span class="text-lg font-bold self-end">@nextCard.DisplayRank</span>
                        </div>
                    }
                    else
                    {
                        <div class="w-24 h-36 bg-slate-800 border-2 border-dashed border-slate-700 rounded-xl flex items-center justify-center text-slate-500 font-bold text-2xl">
                            ?
                        </div>
                    }
                </div>
            </div>

            <!-- Round Feedback -->
            @if (!string.IsNullOrEmpty(feedbackMessage))
            {
                <div class="text-center py-2 px-4 mb-6 rounded-lg bg-slate-950 border border-slate-800">
                    <span class="font-semibold text-amber-300">@feedbackMessage</span>
                </div>
            }

            <!-- Inputs & Guess Buttons -->
            <div class="space-y-4">
                <div class="flex items-center justify-between bg-slate-950 p-3 rounded-lg border border-slate-800">
                    <label class="text-sm font-medium text-slate-300">Bet Amount:</label>
                    <input type="number" min="10" step="10" @bind="betAmount" disabled="@isGuessing" class="bg-slate-900 border border-slate-700 rounded px-3 py-1 w-28 text-right font-bold text-amber-400" />
                </div>

                @if (!isGuessing)
                {
                    <button @onclick="StartRound" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-3 rounded-xl transition">
                        Place Bet & Play
                    </button>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-4">
                        <button @onclick="() => MakeGuess(true)" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl transition">
                            ▲ HIGHER
                        </button>
                        <button @onclick="() => MakeGuess(false)" class="bg-rose-600 hover:bg-rose-500 text-white font-bold py-3 rounded-xl transition">
                            ▼ LOWER
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private Deck deck = new();
    private Card? currentCard;
    private Card? nextCard;
    private decimal betAmount = 50;
    private bool isGuessing = false;
    private string feedbackMessage = "";

    protected override void OnInitialized()
    {
        deck.Reset();
        currentCard = deck.Draw();
    }

    private async Task StartRound()
    {
        if (UserState.CurrentUser!.Balance < betAmount)
        {
            feedbackMessage = "Not enough balance to place this bet.";
            return;
        }

        await UserState.UpdateBalanceAsync(-betAmount);
        nextCard = null;
        feedbackMessage = "Will the next card be higher or lower?";
        isGuessing = true;
    }

    private async Task MakeGuess(bool guessHigher)
    {
        nextCard = deck.Draw();
        isGuessing = false;

        int currentRank = (int)currentCard!.Rank;
        int nextRank = (int)nextCard.Rank;

        if (nextRank == currentRank)
        {
            feedbackMessage = "Push! Ranks are equal. Bet returned.";
            await UserState.UpdateBalanceAsync(betAmount);
        }
        else if ((guessHigher && nextRank > currentRank) || (!guessHigher && nextRank < currentRank))
        {
            feedbackMessage = $"Correct! You won 🪙 {betAmount * 2}!";
            await UserState.UpdateBalanceAsync(betAmount * 2);
        }
        else
        {
            feedbackMessage = "Incorrect guess! House wins.";
        }

        // Shift nextCard to currentCard for the next hand
        currentCard = nextCard;
    }
}