@page "/blackjack"
@rendermode InteractiveServer
@using Midterms.Models
@inject Midterms.Services.UserStateService UserState

<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-black text-amber-400">BLACKJACK</h1>
        <div class="text-slate-400 text-sm">Pays 3:2 on Natural • Dealer Stands on 17</div>
    </div>

    @if (UserState.CurrentUser == null)
    {
        <div class="bg-amber-950/40 border border-amber-800 p-6 rounded-xl text-center">
            <p class="text-amber-300">Please enter a username on the <a href="/" class="underline font-bold">Home Page</a> before playing.</p>
        </div>
    }
    else
    {
        <!-- Table Area -->
        <div class="bg-emerald-900 border-4 border-emerald-950 rounded-3xl p-8 shadow-2xl relative">
            <!-- Dealer Section -->
            <div class="mb-8">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs uppercase font-bold tracking-wider text-emerald-300">Dealer Hand</span>
                    @if (isRoundOver)
                    {
                        <span class="text-sm font-bold bg-emerald-950/60 px-3 py-1 rounded-full text-white">Score: @GetHandScore(dealerHand)</span>
                    }
                </div>
                <div class="flex space-x-3">
                    @for (int i = 0; i < dealerHand.Count; i++)
                    {
                        var card = dealerHand[i];
                        @if (i == 1 && !isRoundOver)
                        {
                            <!-- Hidden Hole Card -->
                            <div class="w-16 h-24 bg-blue-900 border-2 border-white rounded-lg flex items-center justify-center font-bold text-slate-300 shadow">
                                ?
                            </div>
                        }
                        else
                        {
                            <div class="w-16 h-24 bg-white border border-slate-300 rounded-lg p-1.5 flex flex-col justify-between shadow @card.TextColor">
                                <span class="text-sm font-bold leading-none">@card.DisplayRank</span>
                                <span class="text-2xl self-center leading-none">@card.SuitSymbol</span>
                                <span class="text-sm font-bold self-end leading-none">@card.DisplayRank</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Player Section -->
            <div class="mb-8">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs uppercase font-bold tracking-wider text-emerald-300">Your Hand</span>
                    <span class="text-sm font-bold bg-emerald-950/60 px-3 py-1 rounded-full text-white">Score: @GetHandScore(playerHand)</span>
                </div>
                <div class="flex space-x-3">
                    @foreach (var card in playerHand)
                    {
                        <div class="w-16 h-24 bg-white border border-slate-300 rounded-lg p-1.5 flex flex-col justify-between shadow @card.TextColor">
                            <span class="text-sm font-bold leading-none">@card.DisplayRank</span>
                            <span class="text-2xl self-center leading-none">@card.SuitSymbol</span>
                            <span class="text-sm font-bold self-end leading-none">@card.DisplayRank</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Game Result Message -->
            @if (!string.IsNullOrEmpty(resultMessage))
            {
                <div class="text-center py-3 px-6 bg-slate-950/80 border border-slate-700 rounded-xl mb-6">
                    <span class="text-lg font-bold text-amber-300">@resultMessage</span>
                </div>
            }

            <!-- Controls -->
            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-emerald-800">
                @if (isRoundOver)
                {
                    <div class="flex items-center space-x-3">
                        <label class="text-sm font-semibold">Bet Amount:</label>
                        <input type="number" min="10" step="10" @bind="currentBet" class="bg-slate-950 border border-emerald-700 rounded px-3 py-1.5 w-28 text-white" />
                        <button @onclick="StartGame" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-6 py-2 rounded-lg shadow">
                            Deal Hand
                        </button>
                    </div>
                }
                else
                {
                    <div class="flex space-x-3">
                        <button @onclick="Hit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-6 py-2 rounded-lg shadow">Hit</button>
                        <button @onclick="Stand" class="bg-red-600 hover:bg-red-500 text-white font-bold px-6 py-2 rounded-lg shadow">Stand</button>
                    </div>
                    <div class="text-sm text-emerald-200">Current Bet: <span class="font-bold text-white">🪙 @currentBet</span></div>
                }
            </div>
        </div>
    }
</div>

@code {
    private Deck deck = new();
    private List<Card> playerHand = new();
    private List<Card> dealerHand = new();
    private decimal currentBet = 50;
    private bool isRoundOver = true;
    private string resultMessage = "";

    private async Task StartGame()
    {
        if (UserState.CurrentUser!.Balance < currentBet)
        {
            resultMessage = "Insufficient chips to place bet!";
            return;
        }

        await UserState.UpdateBalanceAsync(-currentBet);

        deck.Reset();
        playerHand.Clear();
        dealerHand.Clear();
        resultMessage = "";
        isRoundOver = false;

        playerHand.Add(deck.Draw());
        dealerHand.Add(deck.Draw());
        playerHand.Add(deck.Draw());
        dealerHand.Add(deck.Draw());

        if (GetHandScore(playerHand) == 21)
        {
            await EndRound();
        }
    }

    private async Task Hit()
    {
        playerHand.Add(deck.Draw());
        if (GetHandScore(playerHand) > 21)
        {
            await EndRound();
        }
    }

    private async Task Stand() => await EndRound();

    private async Task EndRound()
    {
        isRoundOver = true;
        int playerScore = GetHandScore(playerHand);

        // Dealer draws until 17 or higher
        while (GetHandScore(dealerHand) < 17 && playerScore <= 21)
        {
            dealerHand.Add(deck.Draw());
        }

        int dealerScore = GetHandScore(dealerHand);

        if (playerScore > 21)
        {
            resultMessage = "Bust! You lose your bet.";
        }
        else if (dealerScore > 21)
        {
            resultMessage = "Dealer busts! You win 🪙 " + (currentBet * 2);
            await UserState.UpdateBalanceAsync(currentBet * 2);
        }
        else if (playerScore == 21 && playerHand.Count == 2 && (dealerScore != 21 || dealerHand.Count > 2))
        {
            decimal blackjackPayout = currentBet + (currentBet * 1.5m);
            resultMessage = "Natural Blackjack! You win 🪙 " + blackjackPayout;
            await UserState.UpdateBalanceAsync(blackjackPayout);
        }
        else if (playerScore > dealerScore)
        {
            resultMessage = "You win! Payout 🪙 " + (currentBet * 2);
            await UserState.UpdateBalanceAsync(currentBet * 2);
        }
        else if (playerScore < dealerScore)
        {
            resultMessage = "Dealer wins. Better luck next time!";
        }
        else
        {
            resultMessage = "Push! Bet returned.";
            await UserState.UpdateBalanceAsync(currentBet);
        }
    }

    private int GetHandScore(List<Card> hand)
    {
        int score = 0;
        int aces = 0;
        foreach (var c in hand)
        {
            if (c.Rank == Rank.Ace) { aces++; score += 11; }
            else if ((int)c.Rank >= 10) { score += 10; }
            else { score += (int)c.Rank; }
        }
        while (score > 21 && aces > 0)
        {
            score -= 10;
            aces--;
        }
        return score;
    }
}