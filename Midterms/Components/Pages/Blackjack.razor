@page "/blackjack"
@rendermode InteractiveServer
@using Midterms.Models
@inject Midterms.Services.UserStateService UserState

<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-black text-[#E4A700] tracking-wide drop-shadow">BLACKJACK</h1>
        <div class="text-amber-200/70 text-sm font-medium">Pays 3:2 on Natural • Dealer Stands on 17</div>
    </div>

    @if (UserState.CurrentUser == null)
    {
        <div class="bg-[#7B1414]/40 border border-[#A46928] p-6 rounded-2xl text-center shadow-lg">
            <p class="text-[#E4A700] font-medium">Please enter a username on the <a href="/" class="underline text-white font-bold">Home Page</a> before playing.</p>
        </div>
    }
    else
    {
        <div class="bg-[#13563B] border-8 border-[#A46928] rounded-3xl p-8 shadow-[0_20px_50px_rgba(0,0,0,0.8)] ring-4 ring-[#000000] relative">
            
            <div class="mb-8">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E4A700]">Dealer Hand</span>
                    @if (isRoundOver)
                    {
                        <span class="text-sm font-bold bg-[#000000]/60 border border-[#A46928] px-3 py-1 rounded-full text-white">Score: @GetHandScore(dealerHand)</span>
                    }
                </div>
                <div class="flex space-x-3">
                    @for (int i = 0; i < dealerHand.Count; i++)
                    {
                        var card = dealerHand[i];
                        @if (i == 1 && !isRoundOver)
                        {
                            <div class="w-16 h-24 bg-[#072475] border-2 border-[#E4A700] rounded-lg flex items-center justify-center font-black text-[#E4A700] text-xl shadow-lg">
                                ♠
                            </div>
                        }
                        else
                        {
                            <div class="w-16 h-24 bg-[#FFFFFF] border border-[#A46928] rounded-lg p-1.5 flex flex-col justify-between shadow-xl @card.TextColor">
                                <span class="text-sm font-bold leading-none">@card.DisplayRank</span>
                                <span class="text-2xl self-center leading-none">@card.SuitSymbol</span>
                                <span class="text-sm font-bold self-end leading-none">@card.DisplayRank</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="mb-8">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs uppercase font-extrabold tracking-widest text-[#E4A700]">Your Hand</span>
                    <span class="text-sm font-bold bg-[#000000]/60 border border-[#A46928] px-3 py-1 rounded-full text-white">Score: @GetHandScore(playerHand)</span>
                </div>
                <div class="flex space-x-3">
                    @foreach (var card in playerHand)
                    {
                        <div class="w-16 h-24 bg-[#FFFFFF] border border-[#A46928] rounded-lg p-1.5 flex flex-col justify-between shadow-xl @card.TextColor">
                            <span class="text-sm font-bold leading-none">@card.DisplayRank</span>
                            <span class="text-2xl self-center leading-none">@card.SuitSymbol</span>
                            <span class="text-sm font-bold self-end leading-none">@card.DisplayRank</span>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(resultMessage))
            {
                <div class="text-center py-3 px-6 bg-[#7B1414]/90 border border-[#E4A700] rounded-xl mb-6 shadow-lg">
                    <span class="text-lg font-bold text-[#E4A700]">@resultMessage</span>
                </div>
            }

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t-2 border-[#A46928]/40">
                @if (isRoundOver)
                {
                    <div class="flex items-center space-x-3">
                        <label class="text-sm font-semibold text-white">Bet Amount:</label>
                        <input type="number" min="10" step="10" @bind="currentBet" class="bg-[#000000] border border-[#A46928] rounded-lg px-3 py-1.5 w-28 text-[#E4A700] font-bold focus:outline-none focus:border-[#E4A700]" />
                        <button @onclick="StartGame" class="bg-[#E4A700] hover:bg-[#A46928] text-[#000000] font-black px-6 py-2 rounded-lg shadow-lg transition">
                            Deal Hand
                        </button>
                    </div>
                }
                else
                {
                    <div class="flex space-x-3">
                        <button @onclick="Hit" class="bg-[#072475] hover:bg-[#072475]/80 text-white font-bold border border-[#E4A700] px-6 py-2 rounded-lg shadow-lg transition">
                            Hit
                        </button>
                        <button @onclick="Stand" class="bg-[#C70000] hover:bg-[#C70000]/80 text-white font-bold border border-[#7B1414] px-6 py-2 rounded-lg shadow-lg transition">
                            Stand
                        </button>
                    </div>
                    <div class="text-sm text-slate-200">Current Bet: <span class="font-bold text-[#E4A700]">🪙 @currentBet</span></div>
                }
            </div>
        </div>
    }
</div>

@code {
    private Deck deck = new();
    private List<Card> playerHand = new();
    private List<Card> dealerHand = new();
    private decimal currentBet = 50;
    private bool isRoundOver = true;
    private string resultMessage = "";

    private async Task StartGame()
    {
        if (UserState.CurrentUser!.Balance < currentBet)
        {
            resultMessage = "Insufficient chips to place bet!";
            return;
        }

        await UserState.UpdateBalanceAsync(-currentBet);

        deck.Reset();
        playerHand.Clear();
        dealerHand.Clear();
        resultMessage = "";
        isRoundOver = false;

        playerHand.Add(deck.Draw());
        dealerHand.Add(deck.Draw());
        playerHand.Add(deck.Draw());
        dealerHand.Add(deck.Draw());

        if (GetHandScore(playerHand) == 21)
        {
            await EndRound();
        }
    }

    private async Task Hit()
    {
        playerHand.Add(deck.Draw());
        if (GetHandScore(playerHand) > 21)
        {
            await EndRound();
        }
    }

    private async Task Stand() => await EndRound();

    private async Task EndRound()
    {
        isRoundOver = true;
        int playerScore = GetHandScore(playerHand);

        while (GetHandScore(dealerHand) < 17 && playerScore <= 21)
        {
            dealerHand.Add(deck.Draw());
        }

        int dealerScore = GetHandScore(dealerHand);

        if (playerScore > 21)
        {
            resultMessage = "Bust! You lose your bet.";
        }
        else if (dealerScore > 21)
        {
            resultMessage = "Dealer busts! You win 🪙 " + (currentBet * 2);
            await UserState.UpdateBalanceAsync(currentBet * 2);
        }
        else if (playerScore == 21 && playerHand.Count == 2 && (dealerScore != 21 || dealerHand.Count > 2))
        {
            decimal blackjackPayout = currentBet + (currentBet * 1.5m);
            resultMessage = "Natural Blackjack! You win 🪙 " + blackjackPayout;
            await UserState.UpdateBalanceAsync(blackjackPayout);
        }
        else if (playerScore > dealerScore)
        {
            resultMessage = "You win! Payout 🪙 " + (currentBet * 2);
            await UserState.UpdateBalanceAsync(currentBet * 2);
        }
        else if (playerScore < dealerScore)
        {
            resultMessage = "Dealer wins. Better luck next time!";
        }
        else
        {
            resultMessage = "Push! Bet returned.";
            await UserState.UpdateBalanceAsync(currentBet);
        }
    }

    private int GetHandScore(List<Card> hand)
    {
        int score = 0;
        int aces = 0;
        foreach (var c in hand)
        {
            if (c.Rank == Rank.Ace) { aces++; score += 11; }
            else if ((int)c.Rank >= 10) { score += 10; }
            else { score += (int)c.Rank; }
        }
        while (score > 21 && aces > 0)
        {
            score -= 10;
            aces--;
        }
        return score;
    }
}