@inherits LayoutComponentBase
@inject Midterms.Services.UserStateService UserState
@inject NavigationManager Navigation
@implements IDisposable

<div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
    <!-- navbar -->
    <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex justify-between items-center shadow-md">
        <div class="flex items-center space-x-6">
            <a href="/" class="text-2xl font-black tracking-wider text-amber-400 uppercase">♠ CardPlus</a>
            <nav class="flex space-x-4">
                <NavLink href="/" Match="NavLinkMatch.All" class="px-3 py-1 rounded hover:bg-slate-800 text-slate-300 font-medium">Home</NavLink>
                <NavLink href="/blackjack" class="px-3 py-1 rounded hover:bg-slate-800 text-slate-300 font-medium">Blackjack</NavLink>
                <NavLink href="/high-low" class="px-3 py-1 rounded hover:bg-slate-800 text-slate-300 font-medium">High / Low</NavLink>
            </nav>
        </div>

        <div>
            @if (UserState.CurrentUser != null)
            {
                <div class="flex items-center space-x-4">
                    <div class="bg-slate-800 border border-slate-700 px-4 py-1.5 rounded-full flex items-center space-x-2">
                        <span class="text-sm text-slate-400">@UserState.CurrentUser.Username</span>
                        <span class="text-amber-400 font-bold">🪙 @UserState.CurrentUser.Balance.ToString("N0")</span>
                    </div>
                    <button @onclick="UserState.Logout" class="text-xs text-red-400 hover:text-red-300 underline">Switch User</button>
                </div>
            }
            else
            {
                <span class="text-sm text-slate-400 italic">Not logged in</span>
            }
        </div>
    </header>

    <!-- main content -->
    <main class="flex-1 p-6 max-w-6xl w-full mx-auto">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized() => UserState.OnChange += StateHasChanged;
    public void Dispose() => UserState.OnChange -= StateHasChanged;
}